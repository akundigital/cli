  },
  "homepage": "https://github.com/akundigital/cli#readme",
  "license": "MIT",
  "keywords": [
    "akundigital",
    "cli"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
